# Copy to .env
NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://loop:loop@localhost:5432/loop
REDIS_URL=redis://localhost:6379
SESSION_SECRET=change-me-32-bytes
ENCRYPTION_KEY=change-me-32-bytes-base64

# Email
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Campaign Loop <no-reply@example.ir>"

# Storage (S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=campaign-loop
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123

# AI via Metis
AI_PROVIDER=mock
METIS_API_KEY=
METIS_BASE_URL=https://api.metisai.ir/openai/v1
METIS_MODEL_FAST=
METIS_MODEL_SMART=
AI_TIMEOUT_FAST_MS=8000
AI_TIMEOUT_SMART_MS=20000
AI_DEBUG=false

# Connectors
CONNECTOR_MODE=mock
ADTRACE_BASE_URL=
INTRACK_BASE_URL=

# Payments
PAYMENT_PROVIDER=sandbox
ZARINPAL_MERCHANT_ID=

# Observability
SENTRY_DSN=
TZ=Asia/Tehran
